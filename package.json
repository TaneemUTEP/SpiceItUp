{
  "name": "IniLife",
  "version": "1.0.0",
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "test:worker": "node --test tests/worker-upload.test.mjs",
    "worker:dev": "wrangler dev --config server/wrangler.jsonc",
    "worker:deploy": "wrangler deploy --config server/wrangler.jsonc"
  },
  "dependencies": {
    "@expo/metro-runtime": "~3.1.3",
    "@react-native-async-storage/async-storage": "1.21.0",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/stack": "^6.3.20",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "expo": "~50.0.0",
    "expo-av": "~13.10.6",
    "expo-camera": "~14.1.1",
    "expo-status-bar": "~1.11.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.73.6",
    "react-native-gesture-handler": "^2.30.0",
    "react-native-reanimated": "^4.2.2",
    "react-native-safe-area-context": "~4.8.2",
    "react-native-screens": "~3.29.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.19.6"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~18.2.45",
    "typescript": "~5.3.3",
    "wrangler": "^4.157.0"
  },
  "private": true
}
