{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "inilife-video-upload",
  "main": "src/index.mjs",
  "compatibility_date": "2026-11-04",
  "r2_buckets": [
    {
      "binding": "VIDEOS",
      "bucket_name": "inilife-videos"
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:8081,http://localhost:19006"
  }
}
